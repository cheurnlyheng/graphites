NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Used to build absolute URLs in the sitemap/robots.txt -- set to the real production domain once it exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe's publishable key (safe to expose client-side, unlike the secret key) -- mounts the embedded
# checkout payment form on /checkout. Find it at dashboard.stripe.com/test/apikeys (starts with pk_test_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional -- leave blank locally. Error reporting is a no-op until these are set to a real Sentry
# project's DSN (create a free project at sentry.io, then paste its DSN here).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production
