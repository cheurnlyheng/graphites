NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Used to build absolute URLs in the sitemap/robots.txt -- set to the real production domain once it exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional -- leave blank locally. Error reporting is a no-op until these are set to a real Sentry
# project's DSN (create a free project at sentry.io, then paste its DSN here).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production
